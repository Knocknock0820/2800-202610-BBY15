<!--
  Partial: navbar.ejs
  Usage: include('partials/navbar', { showLogout: true, activeLink: 'home' })

  Variables:
  - showLogout (optional, default false) : renders the Logout button when true
  - activeLink (optional)               : 'home' | 'about' | 'plants'
                                          marks the matching nav-link as active
-->
<nav class="navbar navbar-expand-lg navbar-dark custom-navbar" style="background-color: #19350c;">
  <div class="container-fluid px-3">
    <a class="navbar-brand fw-bold app-logo" href="/" style="color: white;">🌱 Sprout</a>

    <div class="d-flex align-items-center">
      <% if (typeof showLogout !== 'undefined' && showLogout) { %>
        <!-- User-guide icon — only shown when logged in -->
        <button class="btn me-2" type="button" data-bs-toggle="modal" data-bs-target="#userGuideModal"
          style="border: none !important; background: transparent !important; padding: 0; display: none;"
          id="navGuideBtn">
          <img src="/icons/question.png" alt="User Guide" class="nav-guide-icon" width="28" height="28">
        </button>
      <% } %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link <%= typeof activeLink !== 'undefined' && activeLink === 'home' ? 'active' : '' %>"
             href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof activeLink !== 'undefined' && activeLink === 'about' ? 'active' : '' %>"
             href="/about">About Us</a>
        </li>
        <% if (typeof showLogout !== 'undefined' && showLogout) { %>
          <li class="nav-item">
            <form action="/logout" method="POST" class="d-inline">
              <button type="submit" class="nav-link btn btn-link border-0 text-start text-white">Logout</button>
            </form>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
