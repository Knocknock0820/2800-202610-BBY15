<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Plants</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Main stylesheet -->
    <link rel="stylesheet" href="/css/mainpage.css" />
  </head>

  <body>
    <!-- ===== HEADER ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
      <div class="container-fluid px-3">
        <a class="navbar-brand fw-bold app-logo" href="#">App Name</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link active" href="/landing">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/about">About Us</a>
            </li>
            <li class="nav-item">
              <form action="/logout" method="POST" class="d-inline">
                <button type="submit" class="nav-link btn btn-link border-0 text-start">Logout</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- ===== WEATHER STRIP ===== -->
    <div class="weather-strip">
      <span id="weatherText">Loading weather…</span>
    </div>

    <!-- ===== PLANT LIST ===== -->
    <main class="plants-main container mt-3">
      <h2 class="my-plants-title mb-1">Hello, <%= name %>! 👋</h2>
      <p class="text-muted mb-3">Here are your plants:</p>
      <div class="plant-list" id="plantList">
        <!-- Plant cards are injected here by main.js -->
      </div>
    </main>

    <!-- ===== FLOATING ADD BUTTON (FAB) ===== -->
    <button class="btn-fab" id="btnAdd" title="Add plant">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
    </button>

    <!-- ===== ADD PLANT MODAL (bottom sheet) ===== -->
    <div class="modal-overlay" id="addPlantModal">
      <div class="modal-sheet">
        <h3>Add a New Plant</h3>

        <label for="plantSpecies">Plant Species</label>
        <select id="plantSpecies">
          <option value="" disabled selected>Loading species...</option>
        </select>

        <label for="plantName">Nickname (Optional)</label>
        <input
          type="text"
          id="plantName"
          placeholder="e.g. My Favorite Fern"
          maxlength="40"
        />

        <div class="modal-actions">
          <button class="btn-cancel" id="btnCancel">Cancel</button>
          <button class="btn-save" id="btnSave">Save Plant</button>
        </div>
      </div>
    </div>

    <!-- ===== BOTTOM NAVIGATION BAR ===== -->
    <nav class="bottom-nav">
      <!-- Community tab -->
      <a href="/community">
        <button class="nav-tab" title="Community">
          <img src="/icons/group.png" alt="Community" class="nav-icon" />
        </button>
      </a>

      <!-- Home tab -->
      <a href="/">
        <button class="nav-tab active" title="Home">
          <img src="/icons/home.png" alt="Home" class="nav-icon" />
        </button>
      </a>

      <!-- Profile tab -->
      <a href="/profile">
        <button class="nav-tab" title="Profile">
          <img src="/icons/account.png" alt="Profile" class="nav-icon" />
        </button>
      </a>
    </nav>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- External JS file — all client-side logic lives here -->
    <script src="/js/main.js"></script>
  </body>
</html>
