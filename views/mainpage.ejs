<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: 'My Plants', pageCSS: '/css/mainpage.css' }) %>
</head>

<body>
  <!-- ===== HEADER ===== -->
  <%- include('partials/navbar', { showLogout: true, activeLink: 'home', showGuide: true }) %>

  <!-- ===== WEATHER STRIP ===== -->
  <div class="weather-strip">
    <span id="weatherText">Loading weather…</span>
  </div>

  <!-- ===== GREETING ===== -->
  <div class="greeting-section">
    <h2 class="greeting-title">Hello, <%= name %>! 👋</h2>
    <p class="greeting-subtitle">Here are your plants</p>
  </div>

  <!-- ===== PLANT LIST ===== -->
  <main class="plants-main">
    <div class="plant-list" id="plantList">
      <!-- Plant cards are injected here by main.js -->
    </div>
  </main>

  <!-- ===== FLOATING ADD BUTTON (FAB) ===== -->
  <button class="fab-add" id="btnAdd" title="Add plant" data-bs-toggle="modal"
    data-bs-target="#addPlantModal">
    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="5" x2="12" y2="19" />
      <line x1="5" y1="12" x2="19" y2="12" />
    </svg>
  </button>

  <!-- code adopted from bootstrap : https://getbootstrap.com/docs/5.3/components/modal/
    Modified by: Harun Yaprak -->
  <!-- ===== ADD PLANT MODAL (Bootstrap native) ===== -->
  <div class="modal fade modal-add-plant" id="addPlantModal" tabindex="-1" aria-labelledby="addPlantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0 mt-2">
          <h5 class="modal-title" id="addPlantModalLabel">Add a New Plant</h5>
          <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal"
            aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pt-3">
          <div class="mb-3">
            <label for="plantSpecies" class="form-label">Plant Species</label>
            <select class="form-select" id="plantSpecies">
              <option value="" disabled selected>Loading species...</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="plantName" class="form-label">Nickname (Optional)</label>
            <input type="text" class="form-control" id="plantName" placeholder="e.g. My Favorite Fern" maxlength="40" />
          </div>
          <!-- Image Upload Area -->
          <div class="mb-3">
            <label class="form-label">Plant Photo (Optional)</label>
            <div class="image-upload-area" id="imageUploadArea" onclick="document.getElementById('plantImage').click()">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <p class="upload-text mb-0">Tap to upload a photo</p>
              <p class="upload-hint mb-0">JPG, PNG, WebP or HEIC</p>
            </div>
            <div class="image-preview-container mt-2" id="imagePreviewContainer">
              <img id="imagePreview" src="" alt="Preview" />
              <button type="button" class="image-preview-remove" id="removeImageBtn" onclick="removeImagePreview()">×</button>
            </div>
            <input type="file" id="plantImage" accept="image/jpeg,image/png,image/webp,image/heic" 
              style="display: none;" onchange="handleImageSelect(event)" />
          </div>
        </div>
        <div class="modal-footer border-0 pt-0 px-4 pb-4 d-flex">
          <button type="button" class="btn btn-modal-cancel flex-fill" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-modal-save flex-fill" id="btnSave">Save Plant</button>
        </div>
      </div>
    </div>
  </div>

<!-- ===== EDIT PLANT MODAL ===== -->
  <div class="modal fade modal-edit-plant" id="editPlantModal" tabindex="-1" aria-labelledby="editPlantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0 mt-2">
          <h5 class="modal-title" id="editPlantModalLabel">Edit Plant</h5>
          <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal"
            aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pt-3">
          <input type="hidden" id="editPlantId" />
          <div class="mb-3">
            <label for="editPlantNickname" class="form-label">Nickname</label>
            <input type="text" class="form-control" id="editPlantNickname" placeholder="e.g. My Favourite Fern" maxlength="40" />
          </div>
          <div class="mb-3">
            <label for="editPlantWaterFreq" class="form-label">Water Every (days)</label>
            <input type="number" class="form-control" id="editPlantWaterFreq" placeholder="e.g. 7" min="1" max="365" />
            <div class="form-text edit-freq-hint">How many days between each watering.</div>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0 px-4 pb-4 d-flex">
          <button type="button" class="btn btn-modal-cancel flex-fill" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-modal-save flex-fill" id="btnEditSave">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- User Guide Modal (Bootstrap native) -->
  <div class="modal fade" id="userGuideModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background-color: #d5d3cc; border-radius: 16px; border: 2px solid #687d31;">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" style="color: #19350c; font-family: 'Playfair Display', serif;">User Guide
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center">
          <div class="guide-photo-placeholder mb-3 shadow-sm">
            <img id="guidePhotoDisplay" src="/images/guide_step1.png" alt="User Guide Step"
              onerror="this.src='/images/error.png';">
          </div>

          <p id="guideDescription" class="mb-4" style="color: #19350c; font-weight: 500; min-height: 3em;">
            Welcome to Sprout! We are excited to help you on your plant care journey. This quick guide will show you how
            to make the most of our app and keep your green friends thriving!
          </p>

          <div class="d-flex justify-content-between px-2">
            <button class="btn" onclick="navigateGuide(-1)"
              style="border: 1.5px solid #687d31; color: #687d31; border-radius: 10px; font-weight: 600;">Previous</button>
            <button class="btn" onclick="navigateGuide(1)"
              style="background-color: #687d31; color: #d5d3cc; border-radius: 10px; font-weight: 600; border: none;">Next</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== BOTTOM NAVIGATION BAR ===== -->
  <%- include('partials/footer', { showBottomNav: true, activeTab: 'home', showCopyright: true }) %>

  <!-- External JS file — all client-side logic lives here -->
  <script src="/js/main.js"></script>

  <% if (locals.firstLogin) { %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var userGuideModal = new bootstrap.Modal(document.getElementById('userGuideModal'));
        userGuideModal.show();

        // Remove the query parameter from the URL to prevent showing it again on refresh
        const url = new URL(window.location);
        url.searchParams.delete('firstLogin');
        window.history.replaceState({}, '', url);
      });
    </script>
  <% } %>
</body>

</html>