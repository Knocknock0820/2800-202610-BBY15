<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Welcome to 🌱 Sprout', pageCSS: '/css/landing.css' }) %>
  </head>
  <body>
    <!-- Navbar (no logout on landing page) -->
    <%- include('partials/navbar', { showLogout: false, activeLink: '' }) %>

    <section class="hero-section d-flex align-items-center text-center text-white">

      <!-- Decorative plant images -->
      <div class="plant-frame plant-frame-tl">
        <img src="/images/landing_plant4.png" alt="" aria-hidden="true" class="plant-img" />
      </div>
      <div class="plant-frame plant-frame-tr">
        <img src="/images/landing_plant2.png" alt="" aria-hidden="true" class="plant-img" />
      </div>
      <div class="plant-frame plant-frame-bl">
        <img src="/images/landing_plant1.png" alt="" aria-hidden="true" class="plant-img" />
      </div>
      <div class="plant-frame plant-frame-br">
        <img src="/images/landing_plant3.png" alt="" aria-hidden="true" class="plant-img" />
      </div>

      <!-- Hero Section -->
      <div class="container hero-content">
        <h1 class="display-3 fw-bold mb-4" style="color: #d5d3cc">
          Keep Your Plants Alive
        </h1>
        <p class="lead mb-5">
          Never forget to water your plants again! Our app helps you track
          watering schedules, set reminders, and provides care tips for all your
          green friends.
        </p>

        <!-- Call to Action Buttons -->
        <div class="d-flex justify-content-center gap-3">
          <a
            href="/login"
            class="btn btn-light btn-lg px-5 fw-bold"
            style="background-color: #d5d3cc"
            >Login</a
          >
          <a href="/signup" class="btn btn-outline-light btn-lg px-5 fw-bold"
            >Sign Up</a
          >
        </div>
      </div>
    </section>

    <%- include('partials/footer', { showBottomNav: false }) %>
  </body>
</html>
