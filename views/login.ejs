<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - 🌱 Sprout</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/login.css" />
  </head>
  <body>
    <div class="container">
      <div class="row justify-content-center align-items-center vh-100">
        <div class="col-12 col-md-5 col-lg-4">
          <div class="text-center mb-4">
            <h2 class="fw-bold login-title">Welcome Back</h2>
            <p class="text-muted custom-subtitle">
              Log in to keep your plants happy
            </p>
          </div>

          <div class="card login-card p-4">
            <form action="/login" method="POST">
              <div class="mb-3">
                <% if (error) { %>
                  <p class="text-danger text center small"><%= error %> </p>
                <% } %>
                <label for="email" class="form-label small fw-bold text-muted"
                  >Email Address</label
                >
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  placeholder="name@example.com"
                  required
                />
              </div>

              <div class="mb-4">
                <label
                  for="password"
                  class="form-label small fw-bold text-muted"
                  >Password</label
                >
                <input
                  type="password"
                  class="form-control"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  required
                />
              </div>

              <div class="d-grid">
                <button type="submit" class="btn btn-login">Log In</button>
              </div>
            </form>
          </div>

          <div class="text-center mt-4">
            <p class="small text-muted custom-subtitle">
              Don't have an account?
              <a
                href="/signup"
                class="fw-bold signup-link"
                style="color: #687d31"
                >Sign Up</a
              >
            </p>
            <a
              href="/landing"
              class="small text-muted back-link custom-subtitle"
              >&larr; Back to Landing Page</a
            >
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
