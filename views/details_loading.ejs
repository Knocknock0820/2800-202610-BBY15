<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: (species || 'Plant' ) + ' Loading' , pageCSS: '/css/details.css' }) %>
        <link rel="stylesheet" href="/css/mainpage.css" />
</head>

<body>
    <%- include('partials/navbar', { showLogout: true, activeLink: '' }) %>

        <main class="container my-5 py-4">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="card detail-card border life-cycle-container shadow-sm text-center p-4">
                        <div class="card-body">
                            <h2 class="section-title mb-3">Loading Plant Details</h2>
                            <p class="mb-4" style="color: #687d31; font-size: 1rem;">
                                <%= species || 'This plant' %> does not have a hero image yet.
                            </p>

                            <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
                                <div class="alert alert-warning text-start" role="alert">
                                    <%= errorMessage %>
                                </div>
                                <% } %>

                                    <form action="/details-loading/<%= slug %>/generate" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-success px-4 py-2 fw-bold"
                                            style="background-color: #19350c; border-color: #19350c;">
                                            Generate and Upload
                                        </button>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('partials/footer', { showBottomNav: true, activeTab: '' }) %>
</body>

</html>